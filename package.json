{
  "name": "termswatch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Local-first legal document assistant website and browser extension",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-extension.mjs",
    "build:web": "npm run build && node scripts/package-web.mjs",
    "preview:web": "vite preview --outDir dist-web --host 127.0.0.1 --port 4188 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "8.5.2",
    "@huggingface/transformers": "3.8.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.542.0",
    "pdfjs-dist": "6.2.108",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@eslint/js": "^9.34.0",
    "@types/chrome": "^0.0.326",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.9",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.4",
    "fflate": "0.8.2",
    "globals": "^16.3.0",
    "js-tokens": "^9.0.1",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "semver": "^7.7.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
